# ==============================================================================
# LedgerLine Backend Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# Values: dev | test | prod
# In 'prod', weak secrets or wildcard CORS origins will fail fast at startup.
# ------------------------------------------------------------------------------
ENV=dev

# ------------------------------------------------------------------------------
# 2. Database Connection Strings (PostgreSQL)
# Note: You do NOT need Supabase REST API keys (anon_key / service_role_key).
# Your backend connects directly to PostgreSQL via SQLAlchemy (psycopg3).
#
# Supabase Setup:
# Go to Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use Port 5432 (Session Mode or Direct), NOT Port 6543 (Transaction Mode),
# because LedgerLine relies on session-level row locks and deferred triggers.
#
# Example format for Supabase:
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
#
# Local PostgreSQL default:
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ledgerline

# (Optional) High-privilege role for running Alembic migrations (defaults to DATABASE_URL if unset)
# DATABASE_URL_OWNER=postgresql+psycopg://postgres:[YOUR-PASSWORD]@...:5432/postgres?sslmode=require

# (Optional) Restricted runtime role for normal app execution (defaults to DATABASE_URL if unset)
# DATABASE_URL_APP=postgresql+psycopg://ledgerline_app:[YOUR-PASSWORD]@...:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. Security & Sessions
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing tokens (minimum 32 characters in production)
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars

# Session lifetime in minutes (default 480 = 8 hours)
SESSION_TTL_MINUTES=480

# ------------------------------------------------------------------------------
# 4. Monetary Caps & Timeouts
# ------------------------------------------------------------------------------
# Maximum movement amount in paise (10,000,000,000 = ₹10 Crore)
MAX_AMOUNT_PAISE=10000000000

# Row lock timeout in milliseconds (3000 = 3s)
LOCK_TIMEOUT_MS=3000

# SQL statement timeout in milliseconds (10000 = 10s)
STATEMENT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 5. CORS Origins
# JSON list or comma-separated origins allowed to call the backend API
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 6. AI Surveillance & Financial Copilot (app/review)
# ------------------------------------------------------------------------------
LLM_ENABLED=true
LLM_PROVIDER=auto  # Options: auto | groq | gemini | offline

# Groq API Configuration (Llama 3.3 70B Versatile)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (Gemini 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
